{
  "name": "next-content",
  "type": "module",
  "version": "1.1.0",
  "description": "A powerful, typed content parser for Next.js, Node.js, and Astro-like architectures. Bring your markdown content to life with Zod validation.",
  "author": "sshuvo",
  "license": "MIT",
  "homepage": "https://github.com/sshuvoo/next-content#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sshuvoo/next-content.git"
  },
  "bugs": {
    "url": "https://github.com/sshuvoo/next-content/issues"
  },
  "keywords": [
    "nextjs",
    "content",
    "markdown",
    "mdx",
    "gray-matter",
    "zod",
    "astro",
    "static-site-generator",
    "ssg",
    "blog",
    "parser"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.mjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "bumpp": "^10.3.2",
    "prettier": "3.8.1",
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
